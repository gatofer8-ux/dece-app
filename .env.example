# ===========================================================================
# Sistema de Gestión DECE — Variables de entorno
# ---------------------------------------------------------------------------
# Copia este archivo como `.env` y completa los valores.
# NUNCA subas el archivo `.env` real a un repositorio ni lo compartas.
# ===========================================================================

# --- Autenticación (OBLIGATORIO) -------------------------------------------
# Clave secreta para firmar los JWT de sesión. Genera una única y aleatoria:
#   openssl rand -base64 32
# La aplicación NO arranca si esta variable no está definida.
NEXTAUTH_SECRET=

# URL pública donde funciona el sistema (sin barra final).
NEXTAUTH_URL=http://localhost:3000

# --- Base de datos (OBLIGATORIO) ------------------------------------------
# Ruta del archivo SQLite. En Docker suele ser /data/dece.db (volumen persistente).
DATABASE_FILE=./data/dece.db

# --- Asistente de redacción IA (OPCIONAL) ---------------------------------
# Proveedor principal: Groq (gratuito y ultrarrápido con modelos Llama 70B)
# Obtén tu clave gratuita en: https://console.groq.com/keys
# Si no está definida, Groq se omite silenciosamente y se usa Gemini como respaldo.
GROQ_API_KEY=
# GROQ_MODEL (opcional, por defecto llama-3.3-70b-versatile; cadena de respaldo: openai/gpt-oss-120b, llama-3.1-8b-instant)
GROQ_MODEL=

# Proveedor de respaldo: Google Gemini (AI Studio)
# Si GROQ_API_KEY no está configurada o todos sus modelos fallan, se usa Gemini automáticamente.
# Clave de Google Gemini: https://aistudio.google.com/apikey
# Si se omiten ambas claves, las funciones de IA quedan desactivadas (no rompen la app).
# ADVERTENCIA: al activarlas, el texto seudonimizado de los casos se envía al proveedor de IA.
# Revisa el consentimiento institucional y el acuerdo de tratamiento de datos.
GEMINI_API_KEY=
# GEMINI_MODEL (opcional, por defecto gemini-3.6-flash)
GEMINI_MODEL=

# --- Notificaciones push web (OPCIONAL) ----------------------------------
# Genera el par de llaves una sola vez con:  npx web-push generate-vapid-keys
NEXT_PUBLIC_VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:admin@tu-institucion.edu.ec

# --- Correo saliente (OPCIONAL: recordatorios de citas, alertas) ---------
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM="DECE <no-reply@tu-institucion.edu.ec>"

# --- Datos de demostración (OPCIONAL) -----------------------------------
# Poner en "1" SOLO para sembrar instituciones/usuarios de ejemplo en un
# entorno vacío. En producción déjalo sin definir.
SEED_DEMO=
